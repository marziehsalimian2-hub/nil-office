# ---- Supabase ----
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by lib/supabase/service.ts for privileged maintenance.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Storage bucket (matches migration 0005). Change only if you renamed it.
NEXT_PUBLIC_STORAGE_BUCKET=nil-files

# Public base URL of this deployment — used only to build the absolute
# Buyer Portal link (${NEXT_PUBLIC_APP_URL}/offer/{token}) shown to the
# admin when assigning a buyer. Safe to expose to the browser (it's just
# this site's own origin, no secret).
NEXT_PUBLIC_APP_URL=https://office.nil-management.ir

# ---- NIL Assistant (LLM) ----
# Server-only — never prefix with NEXT_PUBLIC_. Powers the "دستیار نیل"
# chat assistant (lib/assistant/). LLM_PROVIDER currently supports only
# "anthropic" (lib/assistant/llm/anthropic.ts) — see lib/assistant/llm/
# provider.ts if adding another provider later.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=YOUR-ANTHROPIC-API-KEY

# ---- NIL Assistant — Telegram channel ----
# Server-only. Powers app/api/telegram/webhook — see docs/telegram-setup.md
# for the one-time setWebhook call and how to link allowed Telegram
# accounts. Never prefix any of these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=YOUR-BOTFATHER-TOKEN
# A random string YOU choose (e.g. `openssl rand -hex 32`) — registered
# with Telegram via setWebhook and checked on every incoming update.
TELEGRAM_WEBHOOK_SECRET=YOUR-RANDOM-WEBHOOK-SECRET
# Comma-separated numeric Telegram user ids (never usernames), e.g.
# 123456789,987654321 — get a user's numeric id from @userinfobot.
# Do NOT put real ids in this checked-in example file.
TELEGRAM_ALLOWED_USER_IDS=
